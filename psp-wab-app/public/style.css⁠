* {
  box-sizing: border-box;
}

body {
  margin: 0;
  padding: 0;
  background-color: #0f1115;
  color: #ffffff;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
}

header {
  padding: 20px;
  text-align: center;
}

h1 {
  margin: 0 0 15px 0;
  font-size: 24px;
}

.controls {
  margin-bottom: 10px;
}

.btn-upload {
  background-color: #0070d1;
  color: #ffffff;
  padding: 10px 20px;
  border-radius: 6px;
  cursor: pointer;
  font-weight: bold;
  display: inline-block;
  transition: background 0.2s ease;
}

.btn-upload:hover {
  background-color: #005bb5;
}

input[type="file"] {
  display: none;
}

#status {
  font-size: 14px;
  color: #a0a0a0;
}

#game-container {
  width: 960px;
  height: 544px;
  max-width: 95vw;
  max-height: 60vh;
  background-color: #000000;
  border-radius: 8px;
  overflow: hidden;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
  position: relative;
}

#game {
  width: 100%;
  height: 100%;
}
