:root {
  --neon-blue: #00f0ff;
  --neon-pink: #ff007f;
  --neon-purple: #7928ca;
  --panel-bg: #090d16;
  --chassis-dark: #05070c;
  --accent-gold: #ffbe0b;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  user-select: none;
}

body {
  background-color: #030509;
  color: #d1d5db;
  font-family: 'Kantumruy Pro', sans-serif;
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow-x: hidden;
  position: relative;
}

/* Background Cyber Matrix */
.cyber-grid {
  position: fixed;
  inset: 0;
  background-image: 
    linear-gradient(rgba(0, 240, 255, 0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0, 240, 255, 0.03) 1px, transparent 1px);
  background-size: 40px 40px;
  z-index: 0;
}

.ambient-glow {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 90vw;
  height: 90vh;
  background: radial-gradient(circle, rgba(0, 240, 255, 0.08) 0%, rgba(121, 40, 202, 0.06) 45%, transparent 70%);
  filter: blur(120px);
  pointer-events: none;
  z-index: 0;
}

.main-wrapper {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 1100px;
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

/* Header */
.top-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(9, 13, 22, 0.7);
  border: 1px solid rgba(0, 240, 255, 0.2);
  padding: 10px 20px;
  border-radius: 12px;
  backdrop-filter: blur(10px);
}

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
}

.power-indicator {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--neon-blue);
  box-shadow: 0 0 10px var(--neon-blue), 0 0 20px var(--neon-blue);
  animation: pulse 2s infinite ease-in-out;
}

@keyframes pulse {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 1; }
}

.brand-title {
  font-family: 'Orbitron', sans-serif;
  font-weight: 900;
  font-size: 16px;
  letter-spacing: 2px;
  color: #fff;
}

.brand-title span {
  color: var(--neon-blue);
}

.system-stats {
  display: flex;
  gap: 8px;
}

.tag {
  font-family: 'Share Tech Mono', monospace;
  font-size: 11px;
  padding: 3px 8px;
  border-radius: 6px;
  background: rgba(255, 255, 255, 0.05);
  color: #9ca3af;
  border: 1px solid rgba(255, 255, 255, 0.1);
}

/* Virtual Console Chassis */
.console-chassis {
  display: flex;
  align-items: center;
  background: linear-gradient(180deg, #161b26 0%, #080b11 100%);
  padding: 24px 20px;
  border-radius: 40px;
  border: 2px solid rgba(255, 255, 255, 0.12);
  box-shadow: 
    0 25px 60px rgba(0, 0, 0, 0.8),
    0 0 40px rgba(0, 240, 255, 0.15),
    inset 0 1px 2px rgba(255, 255, 255, 0.2);
  gap: 16px;
}

.side-wing {
  flex: 0 0 110px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20px;
}

/* D-PAD */
.dpad {
  position: relative;
  width: 90px;
  height: 90px;
}

.dpad-btn {
  position: absolute;
  background: #1e2433;
  color: #64748b;
  font-size: 10px;
  display: flex;
  justify-content: center;
  align-items: center;
  border: 1px solid rgba(255, 255, 255, 0.08);
  box-shadow: inset 0 2px 4px rgba(255, 255, 255, 0.1), 0 4px 8px rgba(0, 0, 0, 0.6);
  cursor: pointer;
  transition: all 0.1s;
}

.dpad-btn:active {
  background: #0f141d;
  color: var(--neon-blue);
}

.dpad-btn.up { top: 0; left: 30px; width: 30px; height: 32px; border-radius: 6px 6px 0 0; }
.dpad-btn.down { bottom: 0; left: 30px; width: 30px; height: 32px; border-radius: 0 0 6px 6px; }
.dpad-btn.left { top: 30px; left: 0; width: 32px; height: 30px; border-radius: 6px 0 0 6px; }
.dpad-btn.right { top: 30px; right: 0; width: 32px; height: 30px; border-radius: 0 6px 6px 0; }
.dpad-center {
  position: absolute;
  top: 30px;
  left: 30px;
  width: 30px;
  height: 30px;
  background: #1e2433;
}

/* Analog Stick */
.analog-stick {
  width: 58px;
  height: 58px;
  border-radius: 50%;
  background: radial-gradient(circle, #0e121a 0%, #1f2637 100%);
  border: 1px solid rgba(255, 255, 255, 0.1);
  box-shadow: inset 0 3px 6px rgba(0, 0, 0, 0.8), 0 2px 4px rgba(255, 255, 255, 0.05);
  display: flex;
  justify-content: center;
  align-items: center;
}

.analog-cap {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: radial-gradient(circle, #2a3449 30%, #171d2a 100%);
  border: 1px solid rgba(255, 255, 255, 0.15);
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.6);
}

/* Action Buttons */
.action-pad {
  position: relative;
  width: 90px;
  height: 90px;
}

.act-btn {
  position: absolute;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: #1e2433;
  font-family: 'Share Tech Mono', monospace;
  font-size: 13px;
  display: flex;
  justify-content: center;
  align-items: center;
  border: 1px solid rgba(255, 255, 255, 0.1);
  box-shadow: inset 0 2px 4px rgba(255, 255, 255, 0.15), 0 4px 8px rgba(0, 0, 0, 0.6);
  cursor: pointer;
  transition: all 0.1s;
}

.act-btn:active {
  transform: scale(0.92);
  filter: brightness(1.3);
}

.act-btn.triangle { top: 0; left: 31px; color: #10b981; }
.act-btn.circle { top: 31px; right: 0; color: #ef4444; }
.act-btn.cross { bottom: 0; left: 31px; color: #3b82f6; }
.act-btn.square { top: 31px; left: 0; color: #ec4899; }

.branding-sony {
  font-family: 'Orbitron', sans-serif;
  font-size: 9px;
  letter-spacing: 3px;
  color: #475569;
}

/* Screen Frame & Viewport */
.screen-viewport {
  flex: 1;
  position: relative;
  background: #000;
  border-radius: 18px;
  overflow: hidden;
  border: 3px solid #1a2233;
  box-shadow: inset 0 0 30px rgba(0, 0, 0, 0.95);
}

.screen-glare {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 45%;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.04) 0%, transparent 100%);
  pointer-events: none;
  z-index: 5;
}

#game-container {
  width: 100%;
  aspect-ratio: 16 / 9;
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  background: #020408;
}

#game {
  width: 100%;
  height: 100%;
}

canvas {
  width: 100% !important;
  height: 100% !important;
  object-fit: contain;
}

/* Hologram Upload Overlay */
.upload-screen {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background: radial-gradient(circle, rgba(14, 21, 37, 0.95) 0%, rgba(3, 5, 9, 0.98) 100%);
  z-index: 4;
  gap: 14px;
  padding: 20px;
  text-align: center;
}

.hologram-disc {
  position: relative;
  width: 70px;
  height: 70px;
  display: flex;
  justify-content: center;
  align-items: center;
}

.disc-ring {
  position: absolute;
  border-radius: 50%;
  border: 2px dashed rgba(0, 240, 255, 0.4);
}

.disc-ring.outer {
  width: 100%;
  height: 100%;
  animation: rotateDisc 10s linear infinite;
}

.disc-ring.inner {
  width: 75%;
  height: 75%;
  border-style: solid;
  border-color: rgba(255, 0, 127, 0.4) transparent transparent transparent;
  animation: rotateDiscRev 4s linear infinite;
}

.disc-icon {
  width: 32px;
  height: 32px;
  color: var(--neon-blue);
  filter: drop-shadow(0 0 10px var(--neon-blue));
}

@keyframes rotateDisc {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes rotateDiscRev {
  from { transform: rotate(360deg); }
  to { transform: rotate(0deg); }
}

.upload-screen h2 {
  font-family: 'Orbitron', sans-serif;
  font-size: 18px;
  letter-spacing: 2px;
  color: #fff;
  text-shadow: 0 0 15px rgba(0, 240, 255, 0.5);
}

#status {
  font-size: 13px;
  color: #94a3b8;
  max-width: 80%;
  word-break: break-word;
}

#isoPicker {
  display: none;
}

/* Cyber Button */
.cyber-btn {
  position: relative;
  display: inline-flex;
  cursor: pointer;
  overflow: hidden;
  border-radius: 8px;
  padding: 2px;
  background: linear-gradient(90deg, var(--neon-blue), var(--neon-pink));
  box-shadow: 0 0 20px rgba(0, 240, 255, 0.4);
  transition: transform 0.2s, box-shadow 0.2s;
}

.cyber-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 0 30px rgba(255, 0, 127, 0.6);
}

.cyber-btn:active {
  transform: translateY(0);
}

.btn-text {
  display: flex;
  align-items: center;
  gap: 8px;
  background: #090e18;
  padding: 10px 22px;
  border-radius: 6px;
  font-family: 'Orbitron', sans-serif;
  font-size: 13px;
  font-weight: 700;
  color: #fff;
  letter-spacing: 1px;
}

/* Bottom Bar */
.bottom-bar {
  display: flex;
  justify-content: space-between;
  padding: 4px 10px;
}

.chip-status {
  font-family: 'Share Tech Mono', monospace;
  font-size: 12px;
  color: #64748b;
  display: flex;
  align-items: center;
  gap: 6px;
}

.chip-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #10b981;
}

.chip-status span {
  color: #94a3b8;
}

/* Responsive for Mobile Screen */
@media (max-width: 768px) {
  .console-chassis {
    padding: 12px 8px;
    border-radius: 20px;
    gap: 8px;
  }
  .side-wing {
    display: none; /* Hide hardware buttons on small screens to give full width to game */
  }
  .upload-screen h2 {
    font-size: 15px;
  }
  .brand-title {
    font-size: 13px;
  }
  .system-stats {
    display: none;
  }
}
